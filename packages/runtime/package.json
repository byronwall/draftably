{
  "name": "@draftably/runtime",
  "version": "0.4.0",
  "private": false,
  "description": "Portable native Draftably SVG rendering, validation, and optional viewer.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "./dist/element.js"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/runtime/index.d.ts",
      "import": "./dist/index.js"
    },
    "./viewer": {
      "types": "./dist/types/src/runtime/viewer.d.ts",
      "import": "./dist/viewer.js"
    },
    "./element": {
      "types": "./dist/types/src/runtime/element.d.ts",
      "import": "./dist/element.js"
    },
    "./host": {
      "types": "./dist/types/src/runtime/host.d.ts",
      "import": "./dist/host.js"
    },
    "./graph": {
      "types": "./dist/types/src/graph-api/index.d.ts",
      "import": "./dist/graph.js"
    },
    "./viewer.css": "./dist/viewer.css",
    "./host.css": "./dist/host.css",
    "./fonts.css": "./dist/fonts.css",
    "./browser": {
      "types": "./dist/types/src/runtime/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/build-runtime.ts"
  },
  "engines": {
    "node": ">=22.21.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byronwall/draftably.git",
    "directory": "packages/runtime"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
