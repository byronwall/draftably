{
  "name": "@draftably/markdown",
  "version": "0.1.0",
  "description": "Build static SVG diagram assets from Markdown draft fences.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./remark": {
      "types": "./dist/types/remark.d.ts",
      "import": "./dist/remark.js"
    },
    "./markdown-it": {
      "types": "./dist/types/markdown-it.d.ts",
      "import": "./dist/markdown-it.js"
    },
    "./files": {
      "types": "./dist/types/files.d.ts",
      "import": "./dist/files.js"
    },
    "./client": {
      "types": "./dist/types/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/build-markdown.ts",
    "test": "node ../../scripts/prove-markdown-package.ts"
  },
  "dependencies": {
    "@draftably/runtime": "workspace:*"
  },
  "engines": {
    "node": ">=22.21.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byronwall/draftably.git",
    "directory": "packages/markdown"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
