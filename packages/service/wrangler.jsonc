{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "draftably-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Mermaid's parser reaches for a few Node globals.
  "compatibility_flags": ["nodejs_compat"],
  // The slowest example takes about 600 ms; anything far past that is abuse.
  "limits": { "cpu_ms": 5000 },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // The bundled TrueType fonts load as bytes for resvg.
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "ratelimits": [
    // Anonymous renders per IP; cache hits don't count.
    { "name": "ANON_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    // Calls per API key, a guard against a runaway agent loop rather than a price limit.
    { "name": "KEY_LIMIT", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "draftably-service",
      // Set by `wrangler d1 create draftably-service` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // The GitHub OAuth app's client ID. The secret goes in with `wrangler secret put
  // GITHUB_CLIENT_SECRET`, and in .dev.vars for local work.
  "vars": { "GITHUB_CLIENT_ID": "" },
  "env": {
    // `pnpm prove:service` renders every .draft in the repo from one address, and fires parallel
    // keyed renders at one account.
    "proof": {
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "ratelimits": [
        {
          "name": "ANON_LIMIT",
          "namespace_id": "1002",
          "simple": { "limit": 100000, "period": 60 },
        },
        {
          "name": "KEY_LIMIT",
          "namespace_id": "1004",
          "simple": { "limit": 100000, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "draftably-service-proof",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
      "vars": { "GITHUB_CLIENT_ID": "proof-client-id" },
    },
  },
}
