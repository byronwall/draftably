{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "draftably-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Mermaid's parser reaches for a few Node globals.
  "compatibility_flags": ["nodejs_compat"],
  // The slowest example takes about 600 ms; anything far past that is abuse.
  "limits": { "cpu_ms": 5000 },
  // Workers Logs, Traces and Issues; queries in docs/observability.md. Every request is kept
  // (rate 1) while traffic is small. Logs and traces share the Paid plan's 50 GB ingestion and
  // 10 GB-month storage a month. Lower both rates when the dashboard's usage nears that, about
  // 15 M requests a month at today's ~3 KB of logs and spans a request.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // A sign-in link carries its token in the query (/auth/verify?token=), and the token stays
    // good until the confirm button. Keep query strings out of logs and traces.
    "redact_query_string": true,
    "logs": { "enabled": true, "persist": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 },
    // Grouped exceptions, failed invocations, 5xx and console.error. A deploy without this key
    // turns Issues off.
    "issues": { "enabled": true },
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // The bundled TrueType fonts load as bytes for resvg.
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true },
    // The language guide that the MCP tool returns.
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true },
  ],
  "ratelimits": [
    // Anonymous renders per IP; cache hits don't count.
    { "name": "ANON_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    // Calls per API key, a guard against a runaway agent loop rather than a price limit.
    { "name": "KEY_LIMIT", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } },
    // Sign-in emails per IP. The per-address cap is a count in D1.
    { "name": "LOGIN_LIMIT", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
  ],
  // Cloudflare Email Service sends the sign-in links. draftably.dev must be onboarded as a sending
  // domain first.
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "draftably-service",
      "database_id": "e71a83cc-41c8-48cc-983d-399145558bac",
      "migrations_dir": "migrations",
    },
  ],
  // Paid credits: `wrangler secret put STRIPE_SECRET_KEY` and `STRIPE_WEBHOOK_SECRET`. With no key
  // the account page offers no packs.
  "vars": { "EMAIL_FROM": "login@draftably.dev" },
  "routes": [{ "pattern": "api.draftably.dev", "custom_domain": true }],
  "env": {
    // `pnpm prove:service` renders every .draft in the repo from one address, and fires parallel
    // keyed renders at one account.
    "proof": {
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "ratelimits": [
        {
          "name": "ANON_LIMIT",
          "namespace_id": "1002",
          "simple": { "limit": 100000, "period": 60 },
        },
        {
          "name": "KEY_LIMIT",
          "namespace_id": "1004",
          "simple": { "limit": 100000, "period": 60 },
        },
        // High enough for the proof's sign-ins.
        {
          "name": "LOGIN_LIMIT",
          "namespace_id": "1006",
          "simple": { "limit": 1000, "period": 60 },
        },
      ],
      // Locally, wrangler writes each sent email to a file and logs its path.
      "send_email": [{ "name": "EMAIL" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "draftably-service-proof",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "EMAIL_FROM": "login@draftably.dev",
        // A fixture for the webhook signature check; this env is never deployed.
        "STRIPE_WEBHOOK_SECRET": "whsec_proof_fixture",
      },
    },
  },
}
