{
  "name": "@draftably/service",
  "private": true,
  "type": "module",
  "description": "The hosted Draftably render service: GET image URLs, a keyed REST API and an MCP server, in one Cloudflare Worker.",
  "scripts": {
    "dev": "pnpm --dir ../.. runtime:build && wrangler dev",
    "deploy": "pnpm --dir ../.. runtime:build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@draftably/runtime": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "cssstyle": "4.6.0",
    "linkedom": "0.18.12",
    "mermaid": "12.2.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261109.1",
    "wrangler": "4.167.0"
  }
}
