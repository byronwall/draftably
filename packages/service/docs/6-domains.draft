diagram "How draftably.dev serves the site and the API" version=1
subtitle "One domain: the site Worker forwards the API's paths through a service binding"
config link-base="../../.."

group callers "Who asks" color=blue frame=soft
node browser "Person's browser" in=callers icon=globe
node agent "Agent or script" in=callers icon=terminal
node stripe "Stripe webhooks" in=callers icon=credit-card

node reg "Namecheap\nregistrar only" icon=landmark

group zone "Cloudflare DNS: draftably.dev" color=violet
node r_apex "draftably.dev, www\nWorker custom domains" in=zone
node r_mx "MX\nEmail Routing" in=zone
node r_mail "cf-bounce, _dmarc\nsending records" in=zone

group cf "Cloudflare Workers" color=amber
node site "Worker draftably-site\nlanding, docs, editor, /d/{id}" in=cf href="site/worker.ts"
node worker "Worker draftably-api\n/api/*, /mcp, OAuth, /account" in=cf href="packages/service/src/index.ts"
node send "Email Service\nmagic-link mail" in=cf
node routing "Email Routing\nforwards inbound mail" in=cf

node inbox "Byron's inbox" icon=inbox

legend blue "Callers"
legend violet "DNS records"
legend amber "Cloudflare services"
legend line solid "Request or DNS answer"
legend line dashed "Mail"

edge ns reg -> zone "nameservers"
edge q1 browser -> r_apex "pages, /account"
edge q2 agent -> r_apex "/api/*, /mcp"
edge q3 stripe -> r_apex "/api/stripe/webhook"
edge a1 r_apex -> site
edge b1 site -> worker "service binding [1]"
edge m1 worker -> send "send link"
edge m2 r_mail -> send "SPF, DKIM" kind=async
edge m3 r_mx -> routing kind=async
edge m4 routing -> inbox kind=async

state page "Site page" browser r_apex site
state api "API request" browser agent stripe r_apex site worker
state mail "Email" worker send r_mail r_mx routing inbox

footnote 1 "The site Worker passes the request unchanged, so the API sees draftably.dev as its origin. It forwards /api/*, /mcp, /authorize, /oauth/*, /.well-known/oauth-*, /login, /logout, /auth/* and /account*."

layout root engine=compound-flow fit=slide
order cf site worker send routing
