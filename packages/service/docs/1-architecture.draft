diagram "Draftably render service" version=1
subtitle "One Cloudflare Worker serves images, the API, MCP and accounts"
config link-base="../../.."

group callers "Callers" frame=soft color=blue
node img "Image tag or link\nGET /svg, /png" in=callers icon=image
node agent "Script or agent\nPOST /v1/*" in=callers icon=terminal
node mcpc "MCP client\nClaude, Cursor" in=callers icon=bot
node person "Person in a browser\n/account" in=callers icon=user

group worker "Worker: draftably-api" color=slate
group routes "Routes" in=worker
node images "Image URLs\nfree, or keyed" in=routes href="packages/service/src/index.ts"
node api "REST API\napi.ts" in=routes href="packages/service/src/api.ts"
node mcp "MCP server\nmcp.ts, stateless" in=routes href="packages/service/src/mcp.ts"
node account "Account page\naccount.ts" in=routes href="packages/service/src/account.ts"
node webhook "Stripe webhook\nstripe.ts" in=routes href="packages/service/src/stripe.ts"
node auth "Key check\nauth.ts" in=worker href="packages/service/src/auth.ts"
node render "render()\none cache, one price" in=worker color=amber shade=300 href="packages/service/src/render.ts"
node draw "draw()\nMermaid, SVG, PNG" in=worker href="packages/service/src/draw.ts"

group cf "Cloudflare bindings" frame=soft color=violet
node cache "Edge cache\nCache API" in=cf icon=hard-drive
node d1 "D1 database\naccounts, keys, ledger" in=cf icon=database
node limits "Rate limits\nper IP, per key" in=cf icon=gauge

group ext "Outside services" frame=soft color=teal
node github "GitHub OAuth" in=ext icon=github
node stripe "Stripe Checkout" in=ext icon=credit-card

legend blue "Callers"
legend violet "Cloudflare bindings"
legend teal "Outside services"
legend amber "Shared render path" shade=300
legend line solid "Request path"
legend line dashed "Background or callback"

edge e_img img -> images
edge e_agent agent -> api
edge e_mcpc mcpc -> mcp
edge e_person person -> account

edge k_img images -> auth "if Authorization"
edge k_api api -> auth "bearer key"
edge k_mcp mcp -> auth "bearer key"
edge k_d1 auth -> d1 "key hash"

edge d_img images -> render
edge d_api api -> render
edge d_mcp mcp -> render "render_diagram"
edge c_hit render -> cache "match, put"
edge c_draw render -> draw "on a miss"
edge c_spend render -> d1 "guarded spend"
edge c_anon render -> limits "per IP or key"

edge a_gh account -> github "sign in" kind=async
edge a_buy account -> stripe "Checkout session"
edge a_d1 account -> d1 "keys, balance"
edge s_hook stripe -> webhook "paid event" kind=async constraint=false
edge s_d1 webhook -> d1 "add credits once"

state get "Free image URL" img images render cache draw limits
state keyed "Keyed render (REST or MCP)" agent mcpc api mcp auth render cache draw d1 limits
state buy "Buy credits" person account stripe webhook d1 github

layout root engine=compound-flow fit=slide
layout routes column gap=24
