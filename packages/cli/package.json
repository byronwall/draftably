{
  "name": "draftably",
  "private": false,
  "version": "0.6.0",
  "description": "Local diagram DSL viewer and CLI.",
  "type": "module",
  "bin": {
    "draftably": "dist/cli/main.js"
  },
  "scripts": {
    "build": "pnpm --dir ../.. build && node ../../scripts/build-cli.ts",
    "test": "node ../../scripts/check-cli-package.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byronwall/draftably.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "examples",
    "skills",
    "DSL.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES",
    "README.md"
  ],
  "engines": {
    "node": ">=22.21.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
