diagram "Cutover: where each old folder went" version=1
subtitle "Shared packages folded into the app's own folders"

group before "Before: packages/ and src/ root"
group after "After: apps/editor/src/"
-node a1 "uikit: dialog and menu wrappers" in=before
-node a2 "uikit: format, classnames, local, fuzzy match" in=before
-node a3 "uikit: style utils and themes" in=before
-node a4 "uikit/io: keyboard" in=before
-node a5 "api-client/core: transport" in=before
+node b1 "components/" in=after
+node b2 "utils/" in=after
+node b3 "styles/" in=after
+node b4 "state/io/" in=after
+node b5 "protocol/" in=after

+edge e1 a1 -> b1
+edge e2 a2 -> b2
+edge e3 a3 -> b3
+edge e4 a4 -> b4
+edge e5 a5 -> b5
layout root engine=layered direction=right
