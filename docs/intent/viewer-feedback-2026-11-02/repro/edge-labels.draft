diagram "Browser state: one owner per surface" version=1
subtitle "Each browser API has exactly one reader and writer"

node url "location.hash and history" color=slate
node store "localStorage" color=slate
node path "createRouteState" color=blue
node saved "createSavedViews" color=blue
node local "createPrefs" color=blue
node docs "documents" 
node ws "workspace"
node cam "camera, saved board layouts"

edge e1 url -> path "hydrate, popstate; debounced writes"
edge e2 path -> docs "#doc"
edge e3 path -> ws "#layout #view #panelSelection #query #inspectorTab"
edge e4 store -> saved "per user and document"
edge e5 saved -> ws "pinned views"
edge e6 store -> local
edge e7 local -> cam "saved board layouts" kind=async
edge e8 url -> ws "back and forward" kind=async

legend blue "State owner"
legend slate "Browser API"
layout root engine=layered direction=right
