diagram "Cutover: who owns state" version=1
subtitle "Module singletons became owners built at the root"
compare "Before" "After"

-node s1 "module singletons: client, transport, selection"
-node s2 "module-level session map: getOrCreateSession"
-node s3 "RecordManager over column store"
-node s4 "hand-kept types: api types.ts"
+node n1 "root owners in context: docs, workspace, user"
+node n2 "one DocSession at a time, held by docs"
+node n3 "DocStore: one store of rows, read through views"
+node n4 "generated rows, protocol, REST"

+edge e1 s1 -> n1 "built in main.tsx"
+edge e2 s2 -> n2 "owned by createDocs"
+edge e3 s3 -> n3 "reconcile keeps unchanged rows"
+edge e4 s4 -> n4 "gen_rows.py"
layout root engine=layered direction=right
