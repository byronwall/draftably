diagram "Plugin registry: built once at startup, read through lookups" version=1
subtitle "main.ts builds every registry and hands it to the host; plugins read it through a hook, and the workspace scope rebuilds on each project switch"
note "loadConfig and createLogger have no registry: the host passes them to the owners that need them. The test harness mounts the same registries over its own owners; the admin console builds createCache and provides it directly."

node cfg "createConfig()" color=blue
node cache "createCache(store)" color=blue
node jobs "createJobs(cache, queue)" color=blue
group stack "Registry stack, outermost first"
node r1 "ConfigRegistry: useConfig()" in=stack
node r2 "CacheRegistry: useCache()" in=stack
node r3 "JobRegistry: useJobs()" in=stack
node r4 "Workspace scope keyed by project" in=stack color=mint

edge e1 cfg -> r1
edge e2 cache -> r2
edge e3 jobs -> r3
edge e4 jobs -> r4 "project.store"

legend blue "Root owner, core/"
legend mint "Rebuilds on every project switch"
layout root flow direction=right
