diagram "Document lifetime: open, load and reconnect" version=1
subtitle "One session at a time; a dropped socket frees the switch loop"

node route "URL #doc=<id>" color=slate
node active "docs.active()" color=blue
node sw "switchTo: one switch in flight" color=blue
node close "close old session, open new DocSession(id)" color=blue
node connect "session.connect: logs, status, doc:<id>" color=mint
node loaded "loaded; snapshot applied" color=mint
node home "Home mounts DocScope keyed by session" color=slate
node err "recordLoadError" color=blue

edge e1 route -> active "path.signal"
edge e2 active -> sw "start() effect"
edge e3 sw -> close "perform(id)"
edge e4 close -> connect
edge e5 connect -> loaded "doc channel subscribed"
edge e6 loaded -> home "docs.session()"
edge e7 connect -> err "subscribe refused" kind=async

legend blue "docs owner"
legend mint "DocSession"
legend slate "Router and screens"
layout root flow direction=right
