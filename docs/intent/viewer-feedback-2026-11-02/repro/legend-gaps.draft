diagram "Release gate: what runs on merge" version=1
subtitle "Path checks decide which suites run"

node hook "ci/merge-hook" color=slate
node router "route-checks.ts on changed files" color=blue
node fmt "format, lint, type check" color=blue
node webq "web inputs changed?" shape=diamond color=amber
node pyq "python inputs changed?" shape=diamond color=amber
node web "browser suite" color=mint
node py "python suite" color=mint
node watch "file watcher" color=violet

edge e1 hook -> router
edge e2 router -> fmt
edge e3 router -> webq
edge e4 router -> pyq
edge e5 webq -> web "yes"
edge e6 pyq -> py "yes"
edge e7 watch -> router "dev only" kind=async

legend amber "Path gate"
layout root engine=layered direction=right
