diagram "LSTM: one expanded recurrent step" version=1
group cell "A at time t"
node prev "A at t−1"
node next "A at t+1"
node xp "x at t−1" shape=circle
node xt "x at t" shape=circle
node xn "x at t+1" shape=circle
node hp "h at t−1" shape=circle
node ht "h at t" shape=circle
node hn "h at t+1" shape=circle
node cp "C at t−1"
node cn "C at t"
node concat "x and previous h" in=cell shape=box
node f "σ" in=cell shape=box
node i "σ" in=cell shape=box
node candidate "tanh" in=cell shape=box
node o "σ" in=cell shape=box
node forget "×" in=cell shape=circle
node update "×" in=cell shape=circle
node add "+" in=cell shape=circle
node squash "tanh" in=cell shape=pill
node output "×" in=cell shape=circle
edge e1 xp -> prev
edge e2 prev -> hp
edge e3 prev -> cp
edge e4 cp -> forget
edge e5 hp -> concat
edge e6 xt -> concat
edge e7 concat -> f
edge e8 concat -> i
edge e9 concat -> candidate
edge e10 concat -> o
edge e11 f -> forget
edge e12 forget -> add
edge e13 i -> update
edge e14 candidate -> update
edge e15 update -> add
edge e16 add -> cn
edge e17 add -> squash
edge e18 squash -> output
edge e19 o -> output
edge e20 output -> ht
edge e21 ht -> next
edge e22 cn -> next
edge e23 xn -> next
edge e24 next -> hn
layout root flow
layout cell flow
