diagram "Fluid custom transport" version=1
theme blueprint canvas="#090909" text="#eeeeee" connection="#cccccc" title-font=sans annotation-font=sans padding-x=20 padding-y=20 radius=7
theme-color component fill="#0b0b0b" stroke="#505050" ink="#ededed"
theme-color boundary shade=900 fill="#0b0b0b" stroke="#4f4f4f" ink="#efefef"
theme-color core shade=800 fill="#131313" stroke="#515151" ink="#efefef"
node client "Client" color=component
node proxy "Vercel Proxy" color=component
node router "Vercel Function Router" color=component
node api "Lambda API" color=component
group lambda "Lambda VM" color=boundary shade=900
group rust "Rust Core" in=lambda color=core shade=800
node nodejs "Node.js" in=rust color=component
edge request1 client -> proxy "HTTP request"
edge request2 proxy -> router "HTTP request"
edge invoke router -> api "HTTP"
edge lambda_http api -> lambda "HTTP"
edge lambda_return lambda -> api "HTTP" constraint=false
edge tunnel rust -> router "TCP response" constraint=false kind=async
edge response2 router -> proxy "response" constraint=false kind=async
edge response1 proxy -> client "response" constraint=false kind=async
layout root flow direction=right
near proxy client side=right gap=120
near router proxy side=right gap=150
near api router side=below gap=120
near lambda api side=left gap=160
note "Solid arrows: request/invocation. Dashed arrows: response path. Original uses green/blue."
