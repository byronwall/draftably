node c2e0 "Failure\nt0" in=c2
node c2e1 "1st retry\nt0+1" in=c2
node c2e2 "2nd retry\nt0+2" in=c2
node c2e3 "3rd retry\nt0+4" in=c2
node c2e4 "4th retry\nt0+8" in=c2
edge c2next0 c2e0 -> c2e1
edge c2next1 c2e1 -> c2e2
edge c2next2 c2e2 -> c2e3
edge c2next3 c2e3 -> c2e4
layout c2 row
