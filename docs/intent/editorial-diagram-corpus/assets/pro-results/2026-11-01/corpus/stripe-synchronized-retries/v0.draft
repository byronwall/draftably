diagram "Synchronized retries" version=1
note "Server fails all requests at t0. Clients retry together; time increases to the right."
group c1 "Client 1"
node c1e0 "Failure\nt0" in=c1
node c1e1 "1st retry\nt0+1" in=c1
node c1e2 "2nd retry\nt0+2" in=c1
node c1e3 "3rd retry\nt0+4" in=c1
node c1e4 "4th retry\nt0+8" in=c1
edge c1next0 c1e0 -> c1e1
edge c1next1 c1e1 -> c1e2
edge c1next2 c1e2 -> c1e3
edge c1next3 c1e3 -> c1e4
layout c1 row
