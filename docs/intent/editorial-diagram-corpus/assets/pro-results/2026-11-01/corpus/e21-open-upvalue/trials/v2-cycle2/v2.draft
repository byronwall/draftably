# Refinement cycle 2: closest faithful attempt with documented native manual controls.
group closure "ObjClosure"
node fn "function" in=closure
node ups "upvalues" in=closure
group function "ObjFunction"
node chunk "chunk" in=function
node constants "constants" in=function
group up_array "upvalue array"
node idx0 "0" in=up_array
group upvalue "ObjUpvalue"
node location "location" in=upvalue
group stack "Stack"
node a "3" in=stack
node f "<fn>" in=stack
node rest1 "" in=stack
node rest2 "" in=stack
node chunk_rest "…" shape=text
node constants_rest "…" shape=text
edge f_closure f -> closure constraint=false
edge closure_fn fn -> function constraint=false
edge closure_array ups -> up_array constraint=false
edge array_upvalue idx0 -> upvalue constraint=false
edge upvalue_stack location -> a constraint=false
edge chunk_more chunk -> chunk_rest kind=async constraint=false
edge constants_more constants -> constants_rest kind=async constraint=false
note "Stack variables: a holds 3; f holds the closure." near=stack side=below width=360
layout root flow
layout closure cells direction=down
layout function cells direction=down
layout up_array cells
layout upvalue cells
layout stack cells
theme ink canvas="#FFFFFF" text="#111111" connection="#111111" padding-x=8 padding-y=8 radius=0
pin closure x=0 y=110
pin function x=320 y=0
pin up_array x=320 y=210
pin upvalue x=600 y=210
pin stack x=0 y=410
pin chunk_rest x=630 y=34
pin constants_rest x=630 y=78
size fn width=190 height=44
size ups width=190 height=44
size chunk width=190 height=44
size constants width=190 height=44
size idx0 width=100 height=44
size location width=200 height=44
size a width=70 height=44
size f width=70 height=44
size rest1 width=70 height=44
size rest2 width=70 height=44
size chunk_rest width=70 height=36
size constants_rest width=70 height=36
