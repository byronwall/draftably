diagram "TLS handshake" version=1
subtitle "Flight order is schematic; phase durations are labels, not a time scale."
theme signal canvas="#f5f5f5" text="#232323" connection="#737373" title-font=sans annotation-font=sans padding-x=20 padding-y=12 radius=3
theme-color actor fill="#888888" stroke="#555555" ink="#232323"
node client "Client" color=actor
node server "Server" color=actor
edge syn client -> server "SYN"
edge synack server -> client "SYN ACK"
edge hello client -> server "ACK / ClientHello"
edge serverhello server -> client "ServerHello\nCertificate\nServerHelloDone"
edge key client -> server "ClientKeyExchange\nChangeCipherSpec\nFinished"
edge finished server -> client "ChangeCipherSpec\nFinished"
layout root sequence
phase tcp "TCP · 50 ms" syn synack
phase tls "TLS · 110 ms" hello serverhello key finished
