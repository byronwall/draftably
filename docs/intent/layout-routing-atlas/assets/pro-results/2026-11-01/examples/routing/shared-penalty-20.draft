diagram "Routing: overlapping shared segments" version=1
theme drafting padding-y=4
# Fixed rectangles: change only the routing line for a causal comparison.
node s "Hub"
size s width=120 height=24
pin s x=40 y=160
node a "A"
size a width=120 height=56
pin a x=440 y=40
node b "B"
size b width=120 height=56
pin b x=440 y=160
node c "C"
size c width=120 height=56
pin c x=440 y=280
edge a s -> a from=right to=left
edge b s -> b from=right to=left
edge c s -> c from=right to=left
routing parallel-penalty=0 edge-gap=4 fanout-penalty=0 shared-penalty=20
# Row is intentional: suppress automatic flow skip/return lanes while pins freeze geometry.
layout root row
