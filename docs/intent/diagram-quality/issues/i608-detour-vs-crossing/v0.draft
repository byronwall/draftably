# Issue #608: Prefer one crossing over a six-bend detour around a neighboring node
# https://github.com/byronwall/draftably/issues/608
diagram "When one crossing saves a detour" version=1
node n0 "Input" color=slate
size n0 width=164 height=56
group cases "Cases" color=mint
node n1 "First" in=cases color=mint
size n1 width=252 height=71
node n2 "Second" in=cases color=amber
size n2 width=252 height=71
node n3 "Third" in=cases color=mint
size n3 width=252 height=71
node n4 "Fourth" in=cases color=mint
size n4 width=252 height=71
node n5 "Accepted" color=green
size n5 width=164 height=72
node n6 "Declined" color=red
size n6 width=164 height=104
node n7 "Alternate" color=amber
size n7 width=252 height=71
edge e1 n0 -> n1
edge e2 n0 -> n2
edge e3 n0 -> n3
edge e4 n0 -> n4
edge e5 n4 -> n5
edge e6 n4 -> n6
edge e7 n2 -> n7 "Alternate rule"
layout root engine=layered direction=down fit=slide
routing crossing-penalty=900
