diagram "Visual Notes: an agent saves a note" version=1

# expect still *

theme mulberry

group agent_side "Agent session" color=stone
node user "User asks" in=agent_side color=primary shape=pill
node agent "Claude" in=agent_side color=primary
node paths "notes_list_paths" in=agent_side color=primary

group mcp_side "MCP server" color=stone
node auth "Token check" in=mcp_side color=primary shape=diamond
node create "notes_create" in=mcp_side color=primary
node render "Markdown → blocks" in=mcp_side color=primary

group data_side "App data" color=stone
node docs "Docs service" in=data_side color=primary
node pg "Postgres" in=data_side color=primary
node activity "Activity log" in=data_side

node denied "401 Unauthorized" in=mcp_side color=red

edge m1 user -> agent
edge m2 agent -> paths "pick a path"
edge m3 paths -> auth
edge m4 auth -> create "valid"
edge m5 auth -> denied "missing" kind=async
edge m6 create -> render
edge m7 render -> docs
edge m8 docs -> pg "insert"
edge m9 docs -> activity "record" kind=async
edge m10 create -> agent "appUrl" kind=async

layout root flow direction=right gap=56
layout agent_side column gap=24
layout mcp_side column gap=24
layout data_side column gap=24
near denied auth side=right
