diagram "Srcly: the scan result tree" version=1

# expect still *

node root_node "Repository root" color=slate
node src_folder "src/" color=slate
node tests_folder "tests/" color=slate
node viz_folder "viz/" color=slate
node ts_file "Treemap.tsx" color=blue
node py_file "analysis.py" color=blue
node md_file "README.md" color=blue
node component "Treemap component" color=violet
node hook "useTreemapTooltip" color=violet
node func "scan_codebase()" color=violet
node body "(body)" color=violet
node nested "inner closure" color=violet

edge t1 root_node -> src_folder
edge t2 root_node -> tests_folder
edge t3 src_folder -> viz_folder
edge t4 viz_folder -> ts_file
edge t5 src_folder -> py_file
edge t6 root_node -> md_file
edge t7 ts_file -> component
edge t8 ts_file -> hook
edge t9 py_file -> func
edge t10 func -> body
edge t11 func -> nested

node css_file "app.css" color=blue
node rule ".treemap rule" color=violet
edge t12 src_folder -> css_file
edge t13 css_file -> rule

layout root engine=tree root=root_node direction=down
