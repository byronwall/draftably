diagram "Sign-in sequence" version=1
subtitle "Who talks to whom, in order, when a user signs in"

# A sequence diagram: participants across the top, one message per edge line, read top to bottom.
node user "User" shape=pill color=sky
node app "Web app"
node auth "Auth service" color=violet
node db "User store" color=amber

edge m1 user -> app "submit email + password"
edge m2 app -> auth "verify credentials"
edge m3 auth -> db "load user"
edge m4 db -> auth "user record" kind=async
edge m5 auth -> auth "check password hash"
edge m6 auth -> app "session token" kind=async
edge m7 app -> user "signed in" kind=async

layout root sequence
