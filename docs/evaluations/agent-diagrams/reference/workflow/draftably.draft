diagram "Order approval workflow" version=1

node start "Order received" shape=pill color=slate
node validate "Validate order" color=blue
node payment "Payment authorized?" shape=diamond color=amber
node reserve "Reserve stock" color=blue
node stock "Stock available?" shape=diamond color=amber
node pack "Pack order" color=mint
node ship "Ship order" color=mint
node cancel "Cancel order" color=red
node finish "End" shape=pill color=slate

edge e1 start -> validate
edge e2 validate -> payment
edge e3 payment -> cancel "No"
edge e4 payment -> reserve "Yes"
edge e5 reserve -> stock
edge e6 stock -> cancel "No"
edge e7 stock -> pack "Yes"
edge e8 pack -> ship
edge e9 ship -> finish
edge e10 cancel -> finish

layout root engine=layered direction=right gap=48
