diagram "Publishing state machine" version=1

node draft "Draft" shape=pill color=slate
node review "In review" shape=pill color=blue
node changes "Changes requested" shape=pill color=amber
node approved "Approved" shape=pill color=mint
node published "Published" shape=pill color=green
node archived "Archived" shape=pill color=stone

edge submit draft -> review "submit"
edge request_edits review -> changes "request edits"
edge revise changes -> draft "revise"
edge approve review -> approved "approve"
edge publish approved -> published "publish"
edge withdraw approved -> draft "withdraw"
edge archive published -> archived "archive"
edge restore archived -> draft "restore"

layout root engine=layered direction=right
