digraph PublishingStateMachine {
  graph [rankdir=LR, label="Publishing state machine", labelloc=t, fontsize=20, fontname="Helvetica"];
  node  [shape=box, style=rounded, fontname="Helvetica"];
  edge  [fontname="Helvetica"];

  start [shape=point, width=0.15, label=""];

  draft     [label="Draft"];
  in_review [label="In review"];
  changes   [label="Changes requested"];
  approved  [label="Approved"];
  published [label="Published"];
  archived  [label="Archived"];

  start -> draft;
  draft -> in_review [label="submit"];
  in_review -> changes [label="request edits"];
  changes -> draft [label="revise"];
  in_review -> approved [label="approve"];
  approved -> published [label="publish"];
  approved -> draft [label="withdraw"];
  published -> archived [label="archive"];
  archived -> draft [label="restore"];
}
