direction: right

title: Checkout service architecture {near: top-center; shape: text; style.font-size: 24}

customers: Customers {shape: person}

clients: Clients {
  web: Web app
  mobile: Mobile app
}

services: Services {
  gateway: API gateway
  auth: Auth service
  order: Order service
  worker: Worker

  gateway -> auth: validate token
  gateway -> order: requests
}

data: Data {
  db: Orders database {shape: cylinder}
  queue: Queue {shape: queue}
}

customers -> clients.web: use
customers -> clients.mobile: use

clients.web -> services.gateway: HTTPS
clients.mobile -> services.gateway: HTTPS

services.order <-> data.db: read/write
services.order -> data.queue: publish
data.queue -> services.worker: consume
services.worker -> data.db: update
