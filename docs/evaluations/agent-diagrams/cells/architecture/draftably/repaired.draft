diagram "Checkout service architecture" version=1
group client "Client"
group services "Services"
group data "Data"
node web "Web app" in=client
node mobile "Mobile app" in=client
node gateway "API gateway" in=services
node auth "Auth service" in=services
node order "Order service" in=services
node worker "Worker" in=services
node database "Orders database" in=data
node queue "Queue" in=data
edge web_gateway web -> gateway "HTTPS"
edge mobile_gateway mobile -> gateway "HTTPS"
edge gateway_auth gateway -> auth "validate token"
edge gateway_order gateway -> order "request"
edge order_database order -> database "read/write"
edge order_queue order -> queue "publish"
edge queue_worker queue -> worker "consume"
edge worker_database worker -> database "update"
layout root engine=layered direction=right
