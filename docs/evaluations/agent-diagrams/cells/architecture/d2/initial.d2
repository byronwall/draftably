direction: right
label: Checkout service architecture
style: {
  fill: "#FFFFFF"
  font-color: "#172B4D"
  font-size: 24
}
client: Client {
  style: {
    fill: "#F1F5F9"
    stroke: "#64748B"
    font-color: "#172B4D"
  }
  web: Web app {
    style: {
      fill: "#FFFFFF"
      stroke: "#334155"
      font-color: "#172B4D"
    }
  }
  mobile: Mobile app {
    style: {
      fill: "#FFFFFF"
      stroke: "#334155"
      font-color: "#172B4D"
    }
  }
}
services: Services {
  style: {
    fill: "#EFF6FF"
    stroke: "#64748B"
    font-color: "#172B4D"
  }
  gateway: API gateway {
    style: {
      fill: "#DBEAFE"
      stroke: "#1E40AF"
      font-color: "#172B4D"
    }
  }
  auth: Auth service {
    style: {
      fill: "#FFFFFF"
      stroke: "#334155"
      font-color: "#172B4D"
    }
  }
  order: Order service {
    style: {
      fill: "#FFFFFF"
      stroke: "#334155"
      font-color: "#172B4D"
    }
  }
  worker: Worker {
    style: {
      fill: "#FFFFFF"
      stroke: "#334155"
      font-color: "#172B4D"
    }
  }
}
data: Data {
  style: {
    fill: "#F1F5F9"
    stroke: "#64748B"
    font-color: "#172B4D"
  }
  orders: Orders database {
    shape: cylinder
    style: {
      fill: "#FFFFFF"
      stroke: "#334155"
      font-color: "#172B4D"
    }
  }
  queue: Queue {
    style: {
      fill: "#FFFFFF"
      stroke: "#334155"
      font-color: "#172B4D"
    }
  }
}
client.web -> services.gateway: HTTPS
client.mobile -> services.gateway: HTTPS
services.gateway -> services.auth: validate token
services.gateway -> services.order: request
services.order -> data.orders: read/write
services.order -> data.queue: publish
data.queue -> services.worker: consume
services.worker -> data.orders: update
