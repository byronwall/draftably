direction: down
label: Publishing state machine
style: {
  fill: "#FFFFFF"
  font-color: "#172B4D"
  font-size: 24
}
classes: {
  state: {
    shape: rectangle
    style: {
      fill: "#F3F6FA"
      stroke: "#34465E"
      stroke-width: 2
      border-radius: 10
      font-color: "#172B4D"
      font-size: 18
    }
  }
}
draft: Draft {class: state}
review: In review {class: state}
changes: Changes requested {class: state}
approved: Approved {class: state}
published: Published {class: state}
archived: Archived {class: state}
draft -> review: submit
review -> changes: request edits
changes -> draft: revise
review -> approved: approve
approved -> published: publish
published -> archived: archive
archived -> draft: restore
approved -> draft: withdraw
