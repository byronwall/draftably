direction: right
style: {
  fill: "#FFFFFF"
  font-color: "#172B4D"
}
title: Publishing state machine {
  shape: text
  near: top-center
  style: {
    font-size: 26
    bold: true
    font-color: "#172B4D"
  }
}
classes: {
  state: {
    shape: rectangle
    style: {
      fill: "#F3F6FA"
      stroke: "#34465E"
      stroke-width: 2
      border-radius: 10
      font-color: "#172B4D"
      font-size: 18
    }
  }
  return: {
    style: {
      stroke: "#68768A"
      stroke-dash: 5
      font-color: "#34465E"
    }
  }
}
draft: Draft {class: state}
review: In review {class: state}
approved: Approved {class: state}
published: Published {class: state}
archived: Archived {class: state}
changes: Changes requested {class: state}
draft -> review: submit
review -> approved: approve
approved -> published: publish
published -> archived: archive
review -> changes: request edits
changes -> draft: revise {class: return}
approved -> draft: withdraw {class: return}
archived -> draft: restore {class: return}
