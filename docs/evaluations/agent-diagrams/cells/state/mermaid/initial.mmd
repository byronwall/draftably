flowchart LR
  draft(["Draft"])
  review(["In review"])
  changes(["Changes requested"])
  approved(["Approved"])
  published(["Published"])
  archived(["Archived"])

  draft -->|submit| review
  review -->|request edits| changes
  changes -->|revise| draft
  review -->|approve| approved
  approved -->|publish| published
  published -->|archive| archived
  archived -->|restore| draft
  approved -->|withdraw| draft
