digraph Publishing {
  graph [
    label="Publishing state machine",
    labelloc=t,
    labeljust=l,
    fontname="Arial",
    fontsize=22,
    fontcolor="#172B4D",
    bgcolor="white",
    rankdir=TB,
    nodesep=0.55,
    ranksep=0.55,
    pad=0.35,
    splines=true
  ];
  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#F4F7FB",
    color="#35516F",
    fontcolor="#172B4D",
    fontname="Arial",
    fontsize=15,
    penwidth=1.4,
    margin="0.23,0.15"
  ];
  edge [
    color="#425B76",
    fontcolor="#263E58",
    fontname="Arial",
    fontsize=12,
    penwidth=1.3,
    arrowsize=0.8
  ];

  draft [label="Draft"];
  review [label="In review"];
  changes [label="Changes requested"];
  approved [label="Approved"];
  published [label="Published", fillcolor="#EAF3EE"];
  archived [label="Archived"];

  { rank=same; changes; approved; }

  draft -> review [label="submit", weight=8];
  review -> changes [label="request edits"];
  changes -> draft [label="revise", constraint=false];
  review -> approved [label="approve", weight=8];
  approved -> published [label="publish", weight=8];
  published -> archived [label="archive", weight=8];
  archived -> draft [label="restore", constraint=false];
  approved -> draft [label="withdraw", constraint=false];
}
