---
title: Order approval workflow
---
%%{init: {'theme': 'base', 'themeVariables': {'fontFamily': 'Arial, sans-serif', 'fontSize': '16px', 'primaryColor': '#f1f5f9', 'primaryTextColor': '#0f172a', 'primaryBorderColor': '#475569', 'lineColor': '#475569', 'edgeLabelBackground': '#ffffff'}, 'flowchart': {'curve': 'linear', 'nodeSpacing': 36, 'rankSpacing': 24, 'padding': 8}}}%%
flowchart TD
  start(["Start"])
  validate["Validate order"]
  payment{"Payment authorized?"}
  reserve["Reserve stock"]
  stock{"Stock available?"}
  pack["Pack order"]
  ship["Ship order"]
  cancel["Cancel order"]
  finish(["End"])

  start --> validate
  validate --> payment
  payment -->|yes| reserve
  payment -->|no| cancel
  reserve --> stock
  stock -->|yes| pack
  stock -->|no| cancel
  pack --> ship
  ship --> finish
  cancel --> finish

  classDef terminal fill:#0f172a,color:#ffffff,stroke:#0f172a,stroke-width:2px;
  classDef decision fill:#eff6ff,color:#0f172a,stroke:#1d4ed8,stroke-width:2px;
  classDef cancellation fill:#fff7ed,color:#0f172a,stroke:#9a3412,stroke-width:1.5px;
  class start,finish terminal;
  class payment,stock decision;
  class cancel cancellation;
