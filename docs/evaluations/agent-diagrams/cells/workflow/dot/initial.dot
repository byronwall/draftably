digraph OrderApproval {
  graph [rankdir=TB, label="Order approval workflow", labelloc=t, labeljust=c,
         fontname="Arial", fontsize=22, fontcolor="#172B4D", bgcolor="white",
         pad=0.35, nodesep=0.65, ranksep=0.55, splines=polyline];
  node [shape=box, style="rounded,filled", fillcolor="#F3F6FA",
        color="#46566B", fontcolor="#172B4D", fontname="Arial",
        fontsize=14, penwidth=1.3, margin="0.22,0.14"];
  edge [color="#46566B", fontcolor="#172B4D", fontname="Arial",
        fontsize=12, penwidth=1.3, arrowsize=0.8];

  start [label="Start", shape=oval, fillcolor="#E5EEF8"];
  validate [label="Validate order"];
  payment [label="Payment authorized?", shape=diamond, style=filled,
           fillcolor="#FFF5D9", margin="0.16,0.09"];
  reserve [label="Reserve stock"];
  stock [label="Stock available?", shape=diamond, style=filled,
         fillcolor="#FFF5D9", margin="0.16,0.09"];
  pack [label="Pack order"];
  ship [label="Ship order"];
  cancel [label="Cancel order", fillcolor="#FBEDEC"];
  end [label="End", shape=oval, fillcolor="#E5EEF8"];

  start -> validate;
  validate -> payment;
  payment -> reserve [label="yes", weight=5];
  payment -> cancel [label="no"];
  reserve -> stock;
  stock -> pack [label="yes", weight=5];
  stock -> cancel [label="no"];
  pack -> ship;
  ship -> end;
  cancel -> end;
  { rank=same; ship; cancel; }
}
