{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The landing page, docs, playground and editor at draftably.dev. Build with `pnpm site:build`,
  // deploy with `pnpm site:deploy`.
  "name": "draftably-site",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  // Workers Logs, Traces and Issues; queries in packages/service/docs/observability.md. Every request is kept
  // (rate 1) while traffic is small; each page asset is a request here. Logs and traces share the Paid plan's 50 GB ingestion and
  // 10 GB-month storage a month. Lower both rates when the dashboard's usage nears that, about
  // 15 M requests a month at today's ~3 KB of logs and spans a request.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "persist": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 },
    // Grouped exceptions, failed invocations, 5xx and console.error. A deploy without this key
    // turns Issues off.
    "issues": { "enabled": true },
  },
  "assets": {
    "directory": "../dist-site",
    "binding": "ASSETS",
    // A missing page gets the nearest 404.html with status 404, as on GitHub Pages.
    "not_found_handling": "404-page",
    // The Worker sends www to the apex before any asset is served.
    "run_worker_first": true,
  },
  // The render service answers /api/*, /mcp, OAuth and the account pages on this domain; worker.ts
  // forwards them. Deploy draftably-api first: a binding to a Worker that does not exist fails.
  "services": [{ "binding": "API", "service": "draftably-api" }],
  "routes": [
    { "pattern": "draftably.dev", "custom_domain": true },
    { "pattern": "www.draftably.dev", "custom_domain": true },
  ],
}
