{
  "name": "diagram-studio",
  "private": true,
  "version": "8.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && node scripts/check-bindings.ts && vite build",
    "typecheck": "tsc -b --pretty false && node scripts/check-bindings.ts",
    "test:app": "node tests/explorer-fit.ts",
    "test:engines": "node tests/engine-layout.mjs && node tests/engine-sculpt.mjs && node tests/engine-parity.ts",
    "check": "pnpm typecheck && pnpm test:app && pnpm test:engines && pnpm build",
    "changeset:add": "node scripts/add-changeset.ts",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "cli:pack-check": "node scripts/check-cli-package.ts && pnpm --dir packages/cli pack --pack-destination ../../tmp/cli-dist",
    "release:check": "pnpm check && pnpm --dir packages/cli --if-present run build && pnpm --dir packages/cli --if-present run test && pnpm cli:pack-check",
    "release": "pnpm release:check && changeset publish"
  },
  "dependencies": {
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.15.30",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.6"
  },
  "engines": {
    "node": ">=22.21.0"
  }
}
