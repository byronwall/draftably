{
  "name": "diagram-studio",
  "private": true,
  "version": "8.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:engines": "node tests/engine-layout.mjs && node tests/engine-sculpt.mjs && node tests/engine-parity.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && pnpm test:engines",
    "test:unit": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.30",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.21.0"
  }
}
