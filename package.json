{
  "name": "diagram-studio",
  "private": true,
  "version": "8.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "site:dev": "vite -c vite.site.config.ts",
    "site:build": "pnpm build && vite build -c vite.site.config.ts && node scripts/site-pages.ts && cp -R dist dist-site/app",
    "site:og": "node scripts/og-image.ts",
    "docs:assets": "node scripts/diagram-compare/downloads.ts",
    "site:preview": "vite preview -c vite.site.config.ts",
    "build": "pnpm typecheck && vite build",
    "typecheck": "pnpm runtime:build && tsc --noEmit",
    "test:engines": "node tests/engine-layout.mjs && node tests/engine-sculpt.mjs && node tests/engine-parity.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:engines",
    "test:unit": "pnpm runtime:build && vitest run",
    "lint": "eslint .",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm format:check && vitest run",
    "check": "pnpm check:fast && pnpm test:engines && pnpm build",
    "changeset:add": "node scripts/add-changeset.ts",
    "changeset:status": "changeset status",
    "changeset:check": "node scripts/check-changeset.ts",
    "skill:check": "node scripts/check-skill.ts",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "cli:build": "pnpm --dir packages/cli build",
    "cli:pack-check": "pnpm --dir packages/cli test && node scripts/prove-package.ts",
    "release:check": "pnpm check:fast && pnpm test:engines && pnpm cli:build && pnpm cli:pack-check && pnpm runtime:build && pnpm runtime:pack-check && pnpm viewer:pack-check && pnpm markdown:build && pnpm markdown:pack-check && pnpm mermaid:build && pnpm editor:build && pnpm frameworks:build",
    "release": "pnpm release:check && changeset publish",
    "draftably": "node scripts/draftably.mjs",
    "prove:file": "node scripts/prove-file-session.mjs",
    "prove:installed": "node scripts/prove-package.ts --browser",
    "prove:layout": "node scripts/prove-layout-tools.mjs",
    "prove:editors": "node scripts/prove-two-editors.mjs",
    "prove:handles": "node scripts/prove-handles.mjs",
    "prove:slots": "node scripts/prove-slots.mjs",
    "prove:site": "node scripts/prove-site.mjs",
    "prove:themes": "node scripts/prove-themes.mjs",
    "font-metrics": "node scripts/font-metrics.mjs",
    "audit:compare": "node scripts/audit-compare.mjs",
    "shoot": "node scripts/shoot.mjs",
    "bench": "node scripts/bench/run.mjs",
    "bench:host": "pnpm runtime:build && node scripts/bench/host.mjs",
    "bench:graph": "pnpm runtime:build && node scripts/bench/graph.mjs",
    "bench:fresh": "pnpm runtime:build && node scripts/bench/graph-fresh.mjs",
    "eval:diagrams:generate": "node scripts/diagram-compare/generate.mjs",
    "eval:diagrams:tooled": "node scripts/diagram-compare/tooled.mjs",
    "eval:diagrams:replay": "node scripts/diagram-compare/replay.mjs",
    "eval:diagrams:test": "node --test scripts/diagram-compare/adapter.test.mjs",
    "runtime:build": "node scripts/build-runtime.ts",
    "integration:pack": "node scripts/pack-integrations.ts",
    "runtime:pack-check": "node scripts/prove-runtime-package.ts",
    "viewer:pack-check": "node scripts/prove-viewer-package.ts",
    "prove:viewer": "node scripts/prove-viewer-browser.ts",
    "prove:element": "node scripts/prove-element-browser.ts",
    "markdown:build": "node scripts/build-markdown.ts",
    "markdown:pack-check": "node scripts/prove-markdown-package.ts",
    "markdown:browser-check": "node scripts/prove-markdown-browser.ts",
    "markdown:serve-proof": "node scripts/serve-markdown-proof.ts",
    "host:pack-check": "node scripts/prove-host-packages.ts",
    "prove:runtime": "node scripts/prove-runtime-browser.ts",
    "mermaid:build": "node scripts/build-mermaid.ts",
    "frameworks:build": "node scripts/build-frameworks.ts",
    "prove:frameworks": "node scripts/prove-frameworks.ts",
    "prove:recipes": "node scripts/prove-recipes.ts",
    "prove:react-flow": "node scripts/prove-react-flow.ts",
    "editor:build": "node scripts/build-editor.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@d2lang/d2": "0.1.34",
    "@resvg/resvg-js": "2.6.2",
    "@solidjs/router": "^1.0.0",
    "@ts-graphviz/ast": "3.0.10",
    "marked": "^18.1.2",
    "mermaid": "12.2.0",
    "pdfkit": "0.20.2",
    "solid-js": "^1.9.9",
    "svg-to-pdfkit": "0.1.8"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.15.30",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "19.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "jsdom": "26.1.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.64.0",
    "postcss": "8.5.6",
    "prettier": "^3.9.9",
    "react": "19.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^5.0.3",
    "vue": "3.5.22"
  },
  "engines": {
    "node": ">=22.21.0"
  }
}
