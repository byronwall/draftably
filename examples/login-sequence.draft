diagram "Successful password sign-in" version=1
subtitle "The web app hands the password check to the auth service"

# A sequence diagram: each message says what it is, phases name the steps, and the key explains each mark.
footnote "Valid credentials only; error paths are left out. Rows show order, not elapsed time."

node user "User" shape=pill color=sky
node app "Web app"
node auth "Auth service" color=violet
node db "User store" color=amber

# message= says what a message is. A reply names the message it answers.
edge m1 user -> app "submit email + password" message=interaction
edge m2 app -> auth "verify credentials" message=call
edge m3 auth -> db "load user" message=call
edge m4 db -> auth "user record" message=reply answers=m3
# An action is work one participant does. It is not a message to itself.
action m5 auth "check password hash"
edge m6 auth -> app "session token" message=reply answers=m2
edge m7 app -> user "signed in" message=outcome

# A phase is a run of messages, drawn as a row band.
phase submit "Submit" m1 m2
phase verify "Verify" m3 m4 m5
phase result "Return" m6 m7

# A note on a message sits level with its row, in the margin, and moves nothing.
note "The token lasts 15 minutes." near=m6

layout root sequence
